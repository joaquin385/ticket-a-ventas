{
  "name": "ticket-a-ventas",
  "version": "0.1.0",
  "description": "SaaS argentino para digitalizar ventas de comercios mediante fotos de tickets vía WhatsApp",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "whatsapp",
    "ocr",
    "ventas",
    "argentina",
    "saas"
  ],
  "author": "Joaquín",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.3",
    "express": "^5.3.0",
    "zod": "^3.23.8"
  }
}
