# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=tu_token_secreto_para_webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Base de datos (Neon serverless Postgres o Postgres local). Sin valor → memoria
# Usar pooled connection para serverless (Neon):
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/ticket_a_ventas?sslmode=require
# O conexión directa (local):
# DATABASE_URL=postgresql://user:password@localhost:5432/ticket_a_ventas

# Cloudflare R2 (fotos). Sin credenciales → MockStorage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ticket-a-ventas-fotos
R2_PUBLIC_BASE_URL=

# Vision LLM (OpenAI-compatible). Sin key → MockExtractor
VISION_API_KEY=
VISION_API_PROVIDER=openai
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Configuración de la app
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Umbrales de confianza
MIN_CONFIDENCE_SCORE=0.7

# Export HTTP (GET /api/export). Sin token → 401
EXPORT_API_TOKEN=

# Jobs / cron (POST /api/jobs/resumen-semanal). Fallback: EXPORT_API_TOKEN
JOBS_API_TOKEN=
